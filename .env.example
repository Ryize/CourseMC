# Public host and certificate owner
DOMAIN=coursemc.ru
LETSENCRYPT_EMAIL=admin@coursemc.ru

# Django production settings
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=coursemc.ru,www.coursemc.ru,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://coursemc.ru,https://www.coursemc.ru
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

# Persistent paths inside the web container
COURSEMC_DB_PATH=/data/db.sqlite3
COURSEMC_STATIC_ROOT=/app/staticfiles
COURSEMC_MEDIA_ROOT=/app/media
COURSEMC_PRIVATE_MEDIA_ROOT=/app/private_media/lesson_solutions
COURSEMC_SQLITE_TIMEOUT=20

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Integrations. Fill only on the server; never commit real values.
PROXYAPI_API_KEY=
PROXYAPI_REVIEW_MODEL=gpt-4o-mini
COURSEMC_BOT_API_TOKEN=
SOCIAL_AUTH_VK_OAUTH2_KEY=
SOCIAL_AUTH_VK_OAUTH2_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
