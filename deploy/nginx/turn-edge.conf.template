# The official nginx:1.28-alpine image compiles stream modules into the binary.
worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;
events { worker_connections 2048; }

stream {
    # Only the TURN hostname is decrypted here. Website TLS is passed through.
    map $ssl_preread_server_name $tls_upstream {
        __TURN_DOMAIN__ 127.0.0.1:8443;
        default nginx:443;
    }

    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $tls_upstream;
        resolver 127.0.0.11 valid=10s ipv6=off;
        proxy_protocol on;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }

    server {
        # Never publish this unencrypted/PROXY-aware listener on the host.
        listen 127.0.0.1:8443 ssl proxy_protocol;
        ssl_certificate /etc/letsencrypt/live/__TURN_DOMAIN__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__TURN_DOMAIN__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TURN:2m;
        ssl_session_timeout 1h;
        ssl_session_tickets off;
        ssl_handshake_timeout 10s;
        set_real_ip_from 127.0.0.1;
        proxy_pass 172.30.249.3:443;
        proxy_protocol on;
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }
}
